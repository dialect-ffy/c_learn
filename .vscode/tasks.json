{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc.exe 生成活动文件 (安全 ASCII 输出)",
            "command": "cmd.exe",
            "args": [
                "/d",
                "/c",
                "if not exist \"${fileDirname}\\\\build\\\\Debug\" mkdir \"${fileDirname}\\\\build\\\\Debug\" && \"D:\\\\about_vs_code\\\\w64devkit\\\\bin\\\\gcc.exe\" -fdiagnostics-color=always -g \"${file}\" -o \"${fileDirname}\\\\build\\\\Debug\\\\outDebug.exe\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "改为先建目录并输出到 ASCII 名称，避免中文文件名问题。"
        }
    ]
}